{
  "manifest_version": 3,
  "name": "YouTube Full Captions",
  "version": "1.0.0.0",
  "description": "Show YouTube captions line-by-line by syncing from transcript timestamps.",
  "author": "Oded Streigold",
  "icons": {
    "16": "images/icon-16.png",
    "32": "images/icon-32.png",
    "48": "images/icon-48.png",
    "128": "images/icon-128.png"
  },
  "action": {
    "default_icon": {
      "16": "images/icon-16.png",
      "32": "images/icon-32.png",
      "48": "images/icon-48.png",
      "128": "images/icon-128.png"
    },
    "default_title": "YouTube Full Captions — OFF (click to turn ON)"
  },
  "background": { "service_worker": "background.js" },
  "permissions": [
    "scripting",
    "activeTab",
    "tabs",
    "storage",
    "contextMenus",
    "windows"
  ],
  "host_permissions": ["*://*.youtube.com/*"],
  "web_accessible_resources": [{
    "resources": ["settings.html", "settings.js", "settings.css"],
    "matches": ["<all_urls>"]
  }]
}
